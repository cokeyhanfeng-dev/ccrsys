# Authing 密码认证 + code 单点登录 + 企业微信节点提醒
# 将这些变量合并到服务器现有 .env；保留数据库、Redis 和其他业务网关配置。
# 网关地址为占位示例，请替换为实际完整地址。真实 .env 不提交 Git。

# 1. 共用网关凭证：沿用已有密码认证的值
CCR_INTEGRATION_AUTH_APP_ID=10111
CCR_INTEGRATION_AUTH_API_KEY='REPLACE_WITH_EXISTING_AUTHING_API_KEY'
CCR_INTEGRATION_AUTH_APP_CODE=65f3b6d259663202ce3277e8
CCR_INTEGRATION_AUTH_APP_ID_HEADER=X-App-Id
CCR_INTEGRATION_AUTH_API_KEY_HEADER=apikey

# 2. 原有账号密码认证
CCR_INTEGRATION_AUTH_ENABLED=true
CCR_INTEGRATION_AUTH_URL=https://gateway.example.invalid/authing/login

# 3. code 单点登录：GET 换令牌，POST 查用户
CCR_INTEGRATION_AUTH_CODE_ENABLED=true
CCR_INTEGRATION_AUTH_CODE_TOKEN_URL=https://gateway.example.invalid/authing/auth/getAccessTokenByCode
CCR_INTEGRATION_AUTH_USER_INFO_URL=https://gateway.example.invalid/authing/auth/getUserBasicAndPolicyInfo
CCR_INTEGRATION_AUTH_CODE_TOKEN_PATH=data
CCR_INTEGRATION_AUTH_USER_NAME_PATH=data.userBasicInfo.username
CCR_INTEGRATION_AUTH_RESPONSE_CODE_PATH=code
CCR_INTEGRATION_AUTH_RESPONSE_SUCCESS_CODE=200

# 4. 企业微信节点提醒：POST JSON，复用第 1 组 APP_ID/API_KEY 和头名
# 上线启用 true；隔离测试环境保持 false，避免发送真实消息。
CCR_INTEGRATION_WECHAT_ENABLED=true
CCR_INTEGRATION_WECHAT_URL=https://gateway.example.invalid/common/message/send/ent/wechat

# 不填写动态 code/token、接收人 toUser 或提醒正文 text。
# 当前通过行内网关发送，不需要额外配置企微 CorpID/AgentID/Secret。
