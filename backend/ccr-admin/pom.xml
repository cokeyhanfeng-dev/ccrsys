<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ccr</groupId>
        <artifactId>ccr-backend</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>ccr-admin</artifactId>
    <description>启动模块(Spring Boot 入口)</description>

    <dependencies>
        <dependency>
            <groupId>com.ccr</groupId>
            <artifactId>ccr-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ccr</groupId>
            <artifactId>ccr-application</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ccr</groupId>
            <artifactId>ccr-rule</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ccr</groupId>
            <artifactId>ccr-approval</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ccr</groupId>
            <artifactId>ccr-vote</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ccr</groupId>
            <artifactId>ccr-resolution</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ccr</groupId>
            <artifactId>ccr-snapshot</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ccr</groupId>
            <artifactId>ccr-commitment</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ccr</groupId>
            <artifactId>ccr-message</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ccr</groupId>
            <artifactId>ccr-workflow</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- MySQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 健康检查 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- AOP(@DataScope 数据权限切面 §5.4) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>ccr-admin</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.ccr.admin.CcrApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
